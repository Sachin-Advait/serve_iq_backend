# Copy to .env and fill in. .env is gitignored - never commit real values.
#   cp .env.example .env
#
# Load it before running:
#   set -a; source .env; set +a; ./mvnw spring-boot:run

# --- Database --------------------------------------------------------------
DB_URL=jdbc:postgresql://127.0.0.1:5432/serveiq
DB_USERNAME=serveiq
DB_PASSWORD=
DB_POOL_MAX=15
DB_POOL_MIN_IDLE=5

# Hibernate schema handling. Keep validate everywhere except throwaway local
# databases - Flyway owns the schema.
JPA_DDL_AUTO=validate

# --- JWT -------------------------------------------------------------------
# HS256 signing key. Must be at least 32 characters or startup fails.
# Generate one with: openssl rand -base64 48
JWT_SECRET=
JWT_EXPIRATION_MINUTES=720

# --- CORS ------------------------------------------------------------------
# Exact origins the browser app is served from, comma separated. No wildcards.
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# --- Twilio (WhatsApp) -----------------------------------------------------
# Leave blank to disable sending - the app logs and carries on.
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=whatsapp:+14155238886

# --- Cloudinary ------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Firebase (push) -------------------------------------------------------
# Absolute path to the service account json. Blank disables push.
FIREBASE_CREDENTIALS_PATH=

# --- Scheduled report e-mail ------------------------------------------------
# SMTP server. Leave MAIL_HOST blank to send nothing.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_STARTTLS=true
# Recipients, comma separated
REPORT_MAIL_TO=dipeshshrestha876@gmail.com
# Sender address; blank uses MAIL_USERNAME
REPORT_MAIL_FROM=
# Spring cron (sec min hour day month weekday); "-" disables
REPORT_MAIL_CRON=0 0 6 * * *
# Days covered, ending yesterday (1 = yesterday, 7 = last 7 days)
REPORT_MAIL_DAYS=1
# Reports attached as Excel, comma separated
REPORT_MAIL_REPORTS=agent-performance,waiting-sla,no-show,service-demand,agent-utilization

# --- Misc ------------------------------------------------------------------
LOG_LEVEL_APP=INFO
PORT=8085
